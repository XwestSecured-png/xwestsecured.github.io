{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "secrets_scan",
          "informationUri": "https://github.com/XwestSecured-png/xwestsecured.github.io",
          "rules": [
            {
              "id": "SEC-AWS-AKID",
              "name": "AWSaccesskeyID",
              "shortDescription": {
                "text": "AWS access key ID"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            },
            {
              "id": "SEC-AWS-SECRET",
              "name": "AWSsecretaccesskey",
              "shortDescription": {
                "text": "AWS secret access key"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            },
            {
              "id": "SEC-DB-URI",
              "name": "CredentialsinconnectionURI",
              "shortDescription": {
                "text": "Credentials in connection URI"
              },
              "properties": {
                "security-severity": "8.0",
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            },
            {
              "id": "SEC-GENERIC",
              "name": "High-entropysecretassignment",
              "shortDescription": {
                "text": "High-entropy secret assignment"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            },
            {
              "id": "SEC-JWT",
              "name": "JSONWebToken",
              "shortDescription": {
                "text": "JSON Web Token"
              },
              "properties": {
                "security-severity": "5.5",
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            },
            {
              "id": "SEC-PRIVKEY",
              "name": "Privatekeyblock",
              "shortDescription": {
                "text": "Private key block"
              },
              "properties": {
                "security-severity": "9.5",
                "tags": [
                  "security",
                  "CWE-798"
                ]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SEC-PRIVKEY",
          "level": "error",
          "message": {
            "text": "Private key block (----\u2026--). Remove from source, rotate the credential, and load it from a secrets manager or environment variable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/deploy_key.pem"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-AWS-SECRET",
          "level": "error",
          "message": {
            "text": "AWS secret access key (wJal\u2026EY). Remove from source, rotate the credential, and load it from a secrets manager or environment variable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/settings.py"
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-AWS-AKID",
          "level": "error",
          "message": {
            "text": "AWS access key ID (AKIA\u2026LE). Remove from source, rotate the credential, and load it from a secrets manager or environment variable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/settings.py"
                },
                "region": {
                  "startLine": 8,
                  "startColumn": 22
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-DB-URI",
          "level": "error",
          "message": {
            "text": "Credentials in connection URI (Tr0u\u2026-3). Remove from source, rotate the credential, and load it from a secrets manager or environment variable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/settings.py"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 17
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-JWT",
          "level": "warning",
          "message": {
            "text": "JSON Web Token (eyJh\u2026KQ). Remove from source, rotate the credential, and load it from a secrets manager or environment variable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/app.js"
                },
                "region": {
                  "startLine": 6,
                  "startColumn": 11
                }
              }
            }
          ]
        },
        {
          "ruleId": "SEC-GENERIC",
          "level": "warning",
          "message": {
            "text": "High-entropy secret assignment (q8Zt\u2026Y1). Remove from source, rotate the credential, and load it from a secrets manager or environment variable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/settings.py"
                },
                "region": {
                  "startLine": 15,
                  "startColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}