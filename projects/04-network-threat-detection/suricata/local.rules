# =============================================================================
# Custom Suricata rules (Suricata 7.x / 8.x syntax)
# SID range 9000001-9000999 reserved for local rules in this project.
# Set $HOME_NET / $EXTERNAL_NET in suricata.yaml for your environment.
# Test with:  suricata -T -c /etc/suricata/suricata.yaml -S local.rules
# Author: Xiome West | License: MIT
# =============================================================================

# --- Reconnaissance (T1046) ---------------------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL SCAN Possible TCP SYN port scan from external host"; flow:stateless; flags:S,12; detection_filter:track by_src, count 50, seconds 10; classtype:attempted-recon; metadata:mitre_technique_id T1046; sid:9000001; rev:2;)

alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"LOCAL LATERAL Internal SMB sweep - many hosts on 445"; flow:to_server; flags:S,12; detection_filter:track by_src, count 20, seconds 60; classtype:attempted-recon; metadata:mitre_technique_id T1046; sid:9000002; rev:2;)

# --- Exposure / policy (T1133, T1021) -----------------------------------------
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"LOCAL POLICY Inbound RDP connection from internet"; flow:to_server,established; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:mitre_technique_id T1133; sid:9000003; rev:2;)

alert tcp $HOME_NET any -> $EXTERNAL_NET 445 (msg:"LOCAL POLICY Outbound SMB to internet"; flow:to_server; flags:S,12; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:mitre_technique_id T1048; sid:9000004; rev:2;)

alert tcp any any -> $HOME_NET 23 (msg:"LOCAL POLICY Telnet (cleartext) session"; flow:to_server,established; classtype:policy-violation; sid:9000005; rev:1;)

# --- Command & control (T1071, T1573) -----------------------------------------
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL C2 Suspicious default-style User-Agent from internal host"; flow:established,to_server; http.user_agent; pcre:"/^(python-requests|Go-http-client|curl|Wget)\//"; threshold:type limit, track by_src, count 1, seconds 3600; classtype:policy-violation; metadata:mitre_technique_id T1071.001; sid:9000006; rev:2;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LOCAL C2 TLS SNI is a raw IP address (RFC 6066 violation, common in malware)"; flow:established,to_server; tls.sni; pcre:"/^\d{1,3}(\.\d{1,3}){3}$/"; classtype:bad-unknown; metadata:mitre_technique_id T1573; sid:9000007; rev:2;)

# --- DNS tunneling (T1071.004) ------------------------------------------------
alert dns $HOME_NET any -> any 53 (msg:"LOCAL DNS Very long DNS query label - possible tunneling"; dns.query; pcre:"/[a-z0-9]{50,}\./i"; threshold:type both, track by_src, count 20, seconds 60; classtype:bad-unknown; metadata:mitre_technique_id T1071.004; sid:9000008; rev:2;)


# --- Exploitation (T1190) -----------------------------------------------------
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL WEB SQL injection UNION SELECT in URI"; flow:established,to_server; http.uri; content:"union"; nocase; pcre:"/union(\s|%20|\+|\/\*.*?\*\/)+(all(\s|%20|\+)+)?select/Ui"; classtype:web-application-attack; metadata:mitre_technique_id T1190; sid:9000010; rev:2;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL WEB Log4Shell JNDI lookup in request"; flow:established,to_server; http.request_line; content:"${jndi:"; nocase; classtype:attempted-admin; reference:cve,2021-44228; metadata:mitre_technique_id T1190; sid:9000011; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LOCAL WEB Log4Shell JNDI lookup in headers"; flow:established,to_server; http.header; content:"${jndi:"; nocase; classtype:attempted-admin; reference:cve,2021-44228; metadata:mitre_technique_id T1190; sid:9000012; rev:1;)
